# ==========================================
# SpringCabal Games Dev Framework .gitignore
# ==========================================

# Engine runtime & downloads
spring-linux/
spring-linux.7z
/springsettings.cfg

# Compiled binaries and bytecode
*.cwasm
*.wasm
*.sd7
target/
**/target/

# Test runtime outputs, write dirs, and logs
verification/out/
verification/cache/
wasm-test-screens/
area17-test/
wasm-test/
wasm-menu-test/write/
*.log

# Backups & scratch folders
wasm-backups/
claude-work/
codex-work/
gemini-work/
.claude/

# IDE & OS
.vscode/
.idea/
.DS_Store
*.swp
*~

# Local overrides
.cargo/config.toml


# Release packaging output and downloaded engines
release/out/
release/cache/

# Engine releases fetched by setup.sh
engine/

# Generated files (patched maps)
build/

# Python bytecode
__pycache__/
*.pyc

# Personal launcher settings (see launch/local.cfg.example)
launch/local.cfg

# Shared SpringCabal crate: its own git repository
springcabal-rs/
