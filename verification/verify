#!/usr/bin/env bash
set -euo pipefail

VERIFICATION_ROOT=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

# suite: modes.  The first is the default: this table is the only place that
# says so, and verify always passes a mode to games/<suite>.sh.
declare -A MODES=(
    [area17]='headless visual static all'
    [flove]='headless visual outline wisps original'
    [gravitas]='e2e shots headless'
    [hunted]='headless visual'
    [mycube]='headless visual lua-headless'
    [partsneeded]='headless visual'
    [ttld]='headless visual lua-visual pose-parity'
    [unit-scripts]='partsneeded source'
    [gallery]='ceg anim parity'
)
# What `verify all` runs: every in-game assertion suite and the static checks,
# no golden screenshots.  All but the unit-script comparison run headless; that
# one renders under xvfb (the Lua and WASM traces come from the real engine).
ALL_RUNS=(
    'area17 static' 'area17 headless' 'flove headless' 'gravitas e2e'
    'hunted headless' 'mycube headless' 'mycube lua-headless'
    'partsneeded headless' 'ttld headless' 'unit-scripts partsneeded'
)
# What `verify visual` and `verify update-goldens` run: the golden comparisons.
VISUAL_RUNS=(
    'area17 visual' 'flove visual' 'gravitas shots' 'hunted visual'
    'mycube visual' 'partsneeded visual' 'ttld visual'
    'gallery ceg all' 'gallery anim all'
)

usage() {
    cat >&2 <<'EOS'
usage: verify <suite> [mode] [seconds]    run one suite (default mode: first listed)
       verify gallery ceg|anim|parity [game|all] [--only name,...]
       verify list                       suites and their modes
       verify all                        every assertion suite and static check
                                         (headless, except unit-scripts: xvfb)
       verify visual                     every screenshot suite, compared to goldens
       verify update-goldens [suite]     re-record goldens from fresh renders
       verify probe <name> [args]        run a debugging probe (verification/probes)

Environment:
  SPRING_ENGINE_DIR     engine install to test (default: ../spring-bar build,
                        then engine/current from setup.sh)
  SPRING_BAR_DIR        engine checkout (default ../spring-bar next to this repo)
  SPRING_ENGINE_BIN     override the rendering engine binary
  SPRING_HEADLESS_BIN   override the headless engine binary
  GOLDEN_TOLERANCE      override the RMSE % limit against goldens (set per suite)
  KEEP_TEST_ARTIFACTS=1 keep temporary workspaces
  VF_LOCK_FILE          lock that serializes verify runs
                        (default /tmp/springcabal-verify.lock)

Output, logs and screenshots land in verification/out/<suite>-<mode>/.
EOS
    exit 2
}

list_suites() {
    local suite
    for suite in $(printf '%s\n' "${!MODES[@]}" | sort); do
        printf '%-14s %s\n' "$suite" "${MODES[$suite]}"
    done
    printf '\nprobes:\n'
    for suite in "$VERIFICATION_ROOT"/probes/*.sh; do
        printf '  %s\n' "$(basename "$suite" .sh)"
    done
}

run_all() {
    local run failed=()
    for run in "$@"; do
        printf '\n########## %s\n' "$run"
        # shellcheck disable=SC2086
        "$VERIFICATION_ROOT/games/${run%% *}.sh" ${run#* } || failed+=("$run")
    done
    if [[ ${#failed[@]} -gt 0 ]]; then
        printf '\nfailed:\n' >&2
        printf '  %s\n' "${failed[@]}" >&2
        exit 1
    fi
    printf '\nall %d runs passed\n' "$#"
}

# One verify at a time: runs share verification/out/<suite>/ workspaces, the
# font and build caches, and the CPU, and real-time visual scenarios drift
# when they compete for it.  Nested runs skip the lock: this verify's own
# children see VF_LOCK_HELD, and a caller that already holds it (the old
# `flock /tmp/springcabal-verify.lock ./verification/verify ...`) passes the
# locked descriptor down or is our ancestor.  flock on a fresh descriptor
# there would wait for our own parent forever.
take_lock() {
    local lock=${VF_LOCK_FILE:-/tmp/springcabal-verify.lock} fd link holder
    [[ ${VF_LOCK_HELD:-} == "$lock" ]] && return 0
    touch "$lock"
    for fd in /proc/$$/fd/*; do
        link=$(readlink "$fd" 2>/dev/null) || continue
        if [[ $link == "$(readlink -f "$lock")" ]]; then
            fd=${fd##*/}
            break
        fi
        fd=''
    done
    if [[ -z ${fd:-} ]]; then
        exec {fd}>>"$lock"
    fi
    if ! flock -n "$fd"; then
        holder=$(lock_holder "$lock")
        if [[ -n $holder ]] && is_ancestor "$holder"; then
            export VF_LOCK_HELD=$lock
            return 0
        fi
        printf 'waiting for another verify run (%s, pid %s)...\n' "$lock" "${holder:-?}" >&2
        flock "$fd"
    fi
    export VF_LOCK_HELD=$lock
}

# The pid that holds a flock on FILE, from /proc/locks.
lock_holder() {
    local inode
    inode=$(stat -c %i "$1")
    awk -v inode=":$inode" '$2 == "FLOCK" && substr($6, length($6) - length(inode) + 1) == inode { print $5; exit }' /proc/locks
}

is_ancestor() {
    local pid=$PPID
    while [[ -n $pid && $pid -gt 1 ]]; do
        [[ $pid == "$1" ]] && return 0
        pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
    done
    return 1
}

[[ $# -ge 1 ]] || usage

case "$1" in
    list) list_suites; exit 0 ;;
    -h|--help) usage ;;
    all|visual|update-goldens|probe) ;;
    *)
        [[ -n ${MODES[$1]:-} ]] || { printf 'unknown suite: %s\n\n' "$1" >&2; usage; }
        if [[ -n ${2:-} && " ${MODES[$1]} " != *" $2 "* ]]; then
            printf 'unknown mode for %s: %s (modes: %s)\n' "$1" "$2" "${MODES[$1]}" >&2
            exit 2
        fi
        ;;
esac
take_lock

case "$1" in
    all) run_all "${ALL_RUNS[@]}"; exit ;;
    visual) run_all "${VISUAL_RUNS[@]}"; exit ;;
    update-goldens)
        export VF_UPDATE_GOLDENS=1
        if [[ -n ${2:-} ]]; then
            runs=()
            for run in "${VISUAL_RUNS[@]}"; do
                [[ ${run%% *} == "$2" ]] && runs+=("$run")
            done
            [[ ${#runs[@]} -gt 0 ]] || { printf 'no golden suite: %s\n' "$2" >&2; exit 2; }
            run_all "${runs[@]}"
        else
            run_all "${VISUAL_RUNS[@]}"
        fi
        exit
        ;;
    probe)
        [[ -n ${2:-} ]] || { list_suites; exit 2; }
        probe="$VERIFICATION_ROOT/probes/$2.sh"
        [[ -f $probe ]] || { printf 'unknown probe: %s\n' "$2" >&2; exit 2; }
        shift 2
        exec bash "$probe" "$@"
        ;;
esac

suite=$1
shift
[[ $# -gt 0 ]] || set -- "${MODES[$suite]%% *}"
exec "$VERIFICATION_ROOT/games/$suite.sh" "$@"
