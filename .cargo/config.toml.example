# Local development override template
#
# To use:
#   Run `just setup-dev-engine`
#   or copy this file to `.cargo/config.toml`
#
# When active, Cargo overrides remote git dependencies with your local engine crates.
# When deleted, Cargo builds directly from https://github.com/gajop/spring-rust.

[patch."https://github.com/gajop/spring-rust"]
spring = { path = "../spring-bar/rust/crates/spring" }
spring-addons = { path = "../spring-bar/rust/crates/spring-addons" }
