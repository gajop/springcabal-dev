body {
    position: absolute; top: 0; left: 0;
    width: 100%; height: 100%; margin: 0; padding: 0; box-sizing: border-box;
    font-family: FreeSans; font-weight: bold; font-size: 16px;
    color: #e9eef5; background-color: #0a1017;
    display: flex; flex-direction: column;
}
header, main, section, footer, h1, h2, p, div { display: block; }
header { flex-shrink: 0; text-align: center; padding: 24px 0 18px; }
h1 { font-size: 32px; margin: 0 0 6px; }
p { margin: 0; }
header p, .subtitle { color: #8bb1c5; font-size: 14px; }
main { display: flex; flex: 1; min-height: 0; margin: 0 4%; }
section { width: 48%; display: flex; flex-direction: column; min-height: 0; }
section.wasm { margin-right: 4%; }
h2 { font-size: 21px; margin: 0; text-align: center; }
.wasm h2 { color: #39ccef; }
.lua h2 { color: #ffc06a; }
.subtitle { text-align: center; margin: 6px 0 14px; }
.games { flex: 1; min-height: 0; overflow-y: auto; }
button { tab-index: auto; display: block; box-sizing: border-box; color: #e9eef5; font-family: FreeSans; font-weight: bold; cursor: pointer; }
.game { display: flex; align-items: center; width: 100%; min-height: 70px; padding: 7px; margin-bottom: 6px; border: 1px #283745; background-color: #151f2a; text-align: left; }
.game img { width: 82px; height: 50px; margin-right: 12px; }
.details { flex: 1; }
.name { font-size: 18px; }
.built { font-size: 12px; color: #a1c7da; margin-top: 3px; }
.authors { font-size: 10px; color: #a0acb7; margin-top: 3px; }
.wasm .game:hover, .wasm .game.selected { background-color: #174263; border-color: #39ccef; }
.lua .game:hover, .lua .game.selected { background-color: #513a21; border-color: #ffc06a; }
footer { flex-shrink: 0; text-align: center; padding: 14px 0; }
#quit { display: inline-block; width: 160px; padding: 9px; border: 1px #394858; background-color: #202c39; font-size: 18px; }
#quit:hover, #quit.selected { background-color: #773434; border-color: #ec8080; }
footer p { margin-top: 10px; color: #8e9baa; font-size: 13px; }
#error { display: none; position: absolute; bottom: 8px; left: 10%; width: 80%; padding: 14px; background-color: #8e2727; text-align: center; }
#error.visible { display: block; }
